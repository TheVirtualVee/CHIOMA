# ============================================================
# CHIOMA — Production Environment Variables
# ============================================================
# Copy to .env and fill in your credentials.
# All values marked REQUIRED must be set before deployment.
# The runtime will fail hard at boot if any REQUIRED value is missing.
# ============================================================

# ─── DATABASE (REQUIRED) ─────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (URI format)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── WHATSAPP CLOUD API (REQUIRED) ───────────────────────────────────────────
# Meta Developer Console → Your App → WhatsApp → Configuration
WHATSAPP_ACCESS_TOKEN=          # Access token for the business phone number
WHATSAPP_PHONE_NUMBER_ID=       # Phone Number ID (e.g. 123456789012345)
WHATSAPP_APP_SECRET=            # App Secret — used to validate webhook HMAC signatures
WHATSAPP_VERIFY_TOKEN=          # Any random string you choose — used to verify webhook registration

# ─── LLM PROVIDER (REQUIRED — pick ONE) ──────────────────────────────────────
# Options: openai | anthropic | groq | openrouter
LLM_PROVIDER=groq
LLM_API_KEY=                    # API key for the selected provider
LLM_MODEL=                      # Optional — provider default used if blank
#   groq default:       llama-3.1-8b-instant
#   openai default:     gpt-4o-mini
#   anthropic default:  claude-3-haiku-20240307
#   openrouter default: mistralai/mistral-7b-instruct
LLM_TIMEOUT_MS=15000            # Abort LLM call after this many ms (default 15s)
LLM_MAX_RETRIES=2               # Retry on timeout/5xx

# ─── TENANT CONFIGURATION (REQUIRED) ─────────────────────────────────────────
# Comma-separated list of tenant IDs the worker should process
# Format: tenant_{WHATSAPP_PHONE_NUMBER_ID}
CHIOMA_TENANT_IDS=tenant_default

# ─── WORKER RUNTIME (OPTIONAL — defaults shown) ──────────────────────────────
CONSUMER_GROUP=chioma_core
POLL_INTERVAL_MS=1000           # How often (ms) the consumer polls Supabase for new events

# ─── ADMIN SURFACE (REQUIRED for /admin/* endpoints) ─────────────────────────
CHIOMA_ADMIN_SECRET=            # Any strong random secret — protects /admin/* endpoints

# ─── OBSERVABILITY (OPTIONAL) ────────────────────────────────────────────────
LOG_LEVEL=info                  # info | warn | error | debug
NODE_ENV=production
