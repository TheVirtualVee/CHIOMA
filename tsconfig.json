{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "@chioma/*": ["./*"]
    }
  },
  "include": [
    "apps/**/*",
    "core/**/*",
    "infrastructure/**/*",
    "services/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/*.test.ts"
  ]
}
