{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "core/**",
          "infrastructure/**",
          "services/**",
          "package.json",
          "tsconfig.json"
        ]
      }
    }
  ],
  "crons": [
    {
      "path": "/api/recovery-cron",
      "schedule": "*/1 * * * *"
    }
  ]
}