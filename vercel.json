{
  "version": 2,
  "crons": [
    {
      "path": "/api/recovery-cron",
      "schedule": "*/1 * * * *"
    }
  ],
  "builds": [
    {
      "src": "api/*.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "apps/**",
          "core/**",
          "infrastructure/**",
          "services/**",
          "package.json",
          "tsconfig.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.ts"
    },
    {
      "src": "/api/telegram-webhook",
      "dest": "/api/telegram-webhook.ts"
    },
    {
      "src": "/api/recovery-cron",
      "dest": "/api/recovery-cron.ts"
    },
    {
      "src": "/api/simulate-message",
      "dest": "/api/simulate-message.ts"
    },
    {
      "src": "/api/debug-loop",
      "dest": "/api/debug-loop.ts"
    }
  ]
}