{
  "version": 2,
  "builds": [
    {
      "src": "apps/webhook/api/**/*.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "apps/webhook/**",
          "core/**",
          "infrastructure/**",
          "services/**",
          "package.json",
          "tsconfig.base.json"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api/health",            "dest": "apps/webhook/api/health.ts" },
    { "src": "/api/webhook",           "dest": "apps/webhook/api/webhook.ts" },
    { "src": "/api/admin/events",      "dest": "apps/webhook/api/admin/events.ts" },
    { "src": "/api/simulate-message",  "dest": "apps/webhook/api/simulate-message.ts" },
    { "src": "/api/demo",              "dest": "apps/webhook/api/demo.ts" }
  ]
}
