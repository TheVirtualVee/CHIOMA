{
  "name": "chioma",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "infrastructure",
    "services/*",
    "workers/*",
    "cli/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsx tools/dev-pipeline.ts",
    "overseer:check": "tsx tools/overseer-engine/runner.ts",
    "overseer:test": "vitest tools/overseer-engine/overseer-engine.test.ts",
    "init:chioma": "tsx cli/chioma-init/src/main.ts",
    "db:push": "supabase db push --db-url \"$DATABASE_URL\"",
    "db:pull": "supabase db pull --db-url \"$DATABASE_URL\"",
    "db:reset": "supabase db reset --db-url \"$DATABASE_URL\"",
    "deploy:check": "node scripts/deploy-check.mjs",
    "build:webhook": "npm run build --workspace=@chioma/webhook",
    "deploy:webhook": "cd apps/webhook && vercel deploy --prod",
    "build:worker": "cd apps/worker && npm run build"
  },
  "dependencies": {
    "@chioma/business-synthesis-engine": "*",
    "@chioma/business-training-engine": "*",
    "@chioma/chioma-init": "*",
    "@chioma/commitment-engine": "*",
    "@chioma/context-compiler": "*",
    "@chioma/core": "*",
    "@chioma/delivery-service": "*",
    "@chioma/escalation-service": "*",
    "@chioma/infrastructure": "*",
    "@chioma/ingestion-service": "*",
    "@chioma/intent-service": "*",
    "@chioma/llm-orchestrator": "*",
    "@chioma/memory-store": "*",
    "@chioma/reliability-engine": "*",
    "@chioma/worker-commitment-recovery": "*",
    "@chioma/worker-escalation-loop": "*",
    "@chioma/worker-memory-compaction": "*",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/node": "^22.10.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
