{
  "name": "chioma",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "infrastructure",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "echo 'no-op: Vercel builds[] handles compilation'",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "supabase db push --db-url \"$DATABASE_URL\"",
    "db:pull": "supabase db pull --db-url \"$DATABASE_URL\"",
    "db:reset": "supabase db reset --db-url \"$DATABASE_URL\"",
    "deploy:check": "node scripts/deploy-check.mjs",
    "overseer:check": "node scripts/overseer.mjs",
    "build:webhook": "tsc --noEmit --project tsconfig.json",
    "deploy:webhook": "cd apps/webhook && vercel deploy --prod",
    "vercel:typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@chioma/business-learning": "*",
    "@chioma/core": "*",
    "@chioma/employment-logic": "*",
    "@chioma/infrastructure": "*",
    "@chioma/onboarding-service": "*",
    "@chioma/response-service": "*",
    "postgres": "^3.4.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/node": "^24.0.0",
    "@vercel/node": "^5.8.2",
    "dotenv": "^17.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}
